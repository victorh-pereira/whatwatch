# ============================================
# WhatWatch — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================

# API do TMDB (https://www.themoviedb.org/settings/api)
# Aceita tanto a Chave v3 quanto o Read Access Token v4
VITE_TMDB_API_KEY=COLE_SUA_CHAVE_TMDB_AQUI

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_SUA_ANON_KEY_AQUI
